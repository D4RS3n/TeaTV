<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Основная тема приложения -->
    <style name="Theme.TeaTV" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Тема первого мгновения: брендовый системный splash -->
    <style name="Theme.TeaTV.Starting" parent="Theme.SplashScreen">
        <!-- Фон splash — глубокий оникс, совпадающий с фоном логотипа -->
        <item name="windowSplashScreenBackground">#FF131514</item>
        <!-- Картинка по центру: золотая чаша «Медвежий чай из рябины» -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/teatv_splash_icon</item>
        <!-- После splash система переключит activity на основную тему -->
        <item name="postSplashScreenTheme">@style/Theme.TeaTV</item>
    </style>
</resources>
